rules_version = '2';

// ─── FMM 2026 Firebase Storage security rules ──────────────────────
// Mirrors the email-allowlist admin pattern from firestore.rules.
// Keep this list in sync with VITE_ADMIN_EMAILS (full emails only —
// domain entries are client-UI convenience and not trusted server-side).

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'admin@festivalmedievaldemontpellier.org',
          'alex@lesalondesinconnus.com',
          'houseoftherisingarts@gmail.com',
        ];
    }

    // ── Admin-curated media library ──────────────────────────────
    // Used by the Image Picker (admin) to attach hero/illustration
    // assets to vendor cards, broadcasts, etc. Publicly readable so
    // the assets render on the live site; admin-only writes.
    match /media/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Archives photos (section Photos de l'admin) ─────────────
    // Téléversements de la galerie Histoire (Léna). Lecture publique
    // (la page Histoire les affiche), écriture admin seulement.
    match /archives-uploads/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Vendor-uploaded photos ──────────────────────────────────
    // Each merchant uploads their own booth photos under their uid.
    // Publicly readable so the marketplace can render them; only
    // the owner or an admin can write.
    // Owner uploads are size-capped: deletes (resource == null) stay
    // allowed, uploads can't be used to rack up storage/bandwidth costs.
    match /vendors/{uid}/{allPaths=**} {
      allow read:  if true;
      allow write: if (isOwner(uid) || isAdmin())
        && (request.resource == null || request.resource.size < 20 * 1024 * 1024);
    }

    // ── Musician demos / press photos ──────────────────────────
    // Larger cap: demos can be audio files.
    match /musicians/{uid}/{allPaths=**} {
      allow read:  if true;
      allow write: if (isOwner(uid) || isAdmin())
        && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }

    // ── Groupes musicaux (programmation, section admin Musique) ──
    // Photo de chaque groupe à l'affiche ou aux archives. Lecture
    // publique (la page publique Musique les affiche), écriture admin
    // seulement (Éric Pichette gère la programmation).
    // Photos des fiches d'activités, téléversées depuis l'admin.
    match /activites/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /groupes/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── User avatars ────────────────────────────────────────────
    match /users/{uid}/{allPaths=**} {
      allow read:  if true;
      allow write: if (isOwner(uid) || isAdmin())
        && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
    }

    // ── Billets du festivalier ──────────────────────────────────
    // Une facture Zeffy porte un nom, un courriel et un achat. Contrairement
    // aux avatars de /users (lecture publique), ce coffre est strictement
    // privé : seul le propriétaire et les admins y accèdent.
    match /billets/{uid}/{allPaths=**} {
      allow read:   if isOwner(uid) || isAdmin();
      allow write:  if isOwner(uid)
        && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── Documents financiers (section admin Finances) ────────────
    // États financiers, factures, rapports. Contrairement à /media et
    // /archives-uploads, PAS de lecture publique : données financières,
    // admin seulement des deux côtés.
    match /finances/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // ── Portraits du carnet de contacts (section admin) ───────────
    // Personnes réelles (élus, partenaires…), pas de lecture publique.
    match /carnet-contacts/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Deny everything else by default.
  }
}

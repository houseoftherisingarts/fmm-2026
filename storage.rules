rules_version = '2';

// ─── FMM 2026 Firebase Storage security rules ──────────────────────
// Mirrors the email-allowlist admin pattern from firestore.rules.
// Keep this list in sync with VITE_ADMIN_EMAILS (full emails only —
// domain entries are client-UI convenience and not trusted server-side).

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'admin@festivalmedievaldemontpellier.org',
          'alex@lesalondesinconnus.com',
          'houseoftherisingarts@gmail.com',
        ];
    }

    // ── Ce qui reste ouvert à tous, et pourquoi ─────────────────────
    // Audit Loi 25 du 2026-09-02, article 10. Quatre coffres qui
    // portaient des renseignements personnels se lisaient sans aucune
    // condition : les photos envoyées par les membres, les images du mur
    // social, celles du Souk et celles des fiches de Commerce. Ils sont
    // refermés plus bas, chacun sur le droit que la base leur donne.
    //
    // Les images du site, elles, gardent leur lecture ouverte et doivent
    // la garder : ce sont des affiches, des plateaux de jeu, des photos
    // d'archives et des fiches publiées, et personne n'a besoin d'un
    // compte pour voir le site. Ces coffres-là sont /media,
    // /archives-uploads, /activites, /groupes, les blasons et bannières
    // de /guildes, /hebergement-partenaires, /vendors, /musicians et les
    // portraits de /users.
    //
    // Une précision qui compte pour la suite du dossier : une adresse
    // obtenue par getDownloadURL() porte un jeton et ne passe pas par
    // ces règles. Ce que la fermeture ci-dessous arrête, c'est la
    // lecture directe par le chemin du fichier, celle qui n'a jamais
    // demandé la permission à personne.

    // ── Admin-curated media library ──────────────────────────────
    // Used by the Image Picker (admin) to attach hero/illustration
    // assets to vendor cards, broadcasts, etc. Publicly readable so
    // the assets render on the live site; admin-only writes.
    match /media/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Archives photos (section Photos de l'admin) ─────────────
    // Téléversements de la galerie Histoire (Léna). Lecture publique
    // (la page Histoire les affiche), écriture admin seulement.
    match /archives-uploads/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Photos publiques (envoyées par les membres) ──────────────
    // Chacun téléverse les siennes depuis son espace compte (voir
    // photosPubliques.ts) : redimensionnées côté navigateur en webp
    // avant l'envoi, donc le type est verrouillé et la taille reste
    // modeste malgré la limite large (marge de sécurité, pas un
    // objectif). Suppression réservée à l'équipe (section Photos reçues).
    //
    // Lecture refermée le 2026-09-02 (Loi 25, article 10) : le fichier
    // ne se lit plus par son chemin que par la personne qui l'a envoyé
    // et par l'équipe. C'est le droit que la base donne à une photo
    // privée, et la photo privée est désormais le défaut (PhotosPanel).
    // Une photo que la personne ouvre aux autres membres, ou que
    // l'équipe retient pour une affiche, continue de s'afficher : elle
    // voyage par son adresse de téléchargement, qui porte son propre
    // jeton et ne passe pas par cette règle.
    match /photos-publiques/{uid}/{fileName} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if (isOwner(uid) || isAdmin())
        && request.resource.contentType == 'image/webp'
        && request.resource.size < 15 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Le mur social : la photo ou la vidéo d'un billet ──────────
    // La vidéo (Alex, 2026-08-28) part telle quelle, sans passer par
    // le redimensionnement webp de la photo — d'où les deux types
    // acceptés et une limite large (60 Mo) propre à la vidéo. Le VIP
    // qui la débloque se vérifie côté client (composeur du mur); ici,
    // seul le propriétaire écrit, quel que soit le type.
    // Lecture alignée sur la base le 2026-09-02 (Loi 25, article 10) :
    // le mur se lit entre membres connectés, donc son image aussi.
    match /mur/{uid}/{fileName} {
      allow read:   if signedIn();
      allow create: if isOwner(uid)
        && (
          (request.resource.contentType == 'image/webp'
           && request.resource.size < 15 * 1024 * 1024)
          || (request.resource.contentType in ['video/mp4', 'video/webm']
              && request.resource.size < 60 * 1024 * 1024)
        );
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── Le blason d'une guilde ─────────────────────────────────
    // Écrit par un admin de la guilde (lu dans Firestore) ou l'équipe.
    // La bannière large de la guilde (Alex, 2026-08-28), même droit que
    // le blason : un admin de la guilde, ou l'équipe.
    match /guildes/{guildeId}/banniere.webp {
      allow read:  if true;
      allow write: if signedIn()
        && (isAdmin()
            || request.auth.uid in firestore.get(/databases/(default)/documents/guildes/$(guildeId)).data.admins)
        && (request.resource == null
            || (request.resource.contentType == 'image/webp' && request.resource.size < 8 * 1024 * 1024));
    }

    match /guildes/{guildeId}/blason.webp {
      allow read:  if true;
      allow write: if signedIn()
        && (isAdmin()
            || request.auth.uid in firestore.get(/databases/(default)/documents/guildes/$(guildeId)).data.admins)
        && (request.resource == null
            || (request.resource.contentType == 'image/webp' && request.resource.size < 6 * 1024 * 1024));
    }

    // ── Hébergeurs partenaires (formulaire public /hebergement) ──
    // Un hébergeur téléverse ses photos AVANT le paiement, sans compte :
    // la création est publique, bornée aux images de moins de 8 Mo. Les
    // fichiers vivent sous `hebergement-partenaires/{id}/{n}.{ext}`, où
    // l'id est celui du document Firestore généré côté client. Lecture
    // publique : les photos nourrissent la liste des hébergements.
    match /hebergement-partenaires/{allPaths=**} {
      allow read:  if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Vendor-uploaded photos ──────────────────────────────────
    // Each merchant uploads their own booth photos under their uid.
    // Publicly readable so the marketplace can render them; only
    // the owner or an admin can write.
    // Owner uploads are size-capped: deletes (resource == null) stay
    // allowed, uploads can't be used to rack up storage/bandwidth costs.
    match /vendors/{uid}/{allPaths=**} {
      allow read:  if true;
      allow write: if (isOwner(uid) || isAdmin())
        && (request.resource == null || request.resource.size < 20 * 1024 * 1024);
    }

    // ── Musician demos / press photos ──────────────────────────
    // Larger cap: demos can be audio files.
    match /musicians/{uid}/{allPaths=**} {
      allow read:  if true;
      allow write: if (isOwner(uid) || isAdmin())
        && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }

    // ── Groupes musicaux (programmation, section admin Musique) ──
    // Photo de chaque groupe à l'affiche ou aux archives. Lecture
    // publique (la page publique Musique les affiche), écriture admin
    // seulement (Éric Pichette gère la programmation).
    // Photos des fiches d'activités, téléversées depuis l'admin.
    match /activites/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /groupes/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── User avatars + bannière (VIP : GIF ≤ 8 Mo, vidéo ≤ 15 Mo) ──
    match /users/{uid}/{allPaths=**} {
      allow read:  if true;
      allow write: if (isOwner(uid) || isAdmin())
        && (request.resource == null || request.resource.size < 15 * 1024 * 1024);
    }

    // ── Billets du festivalier ──────────────────────────────────
    // Une facture Zeffy porte un nom, un courriel et un achat. Contrairement
    // aux avatars de /users (lecture publique), ce coffre est strictement
    // privé : seul le propriétaire et les admins y accèdent.
    match /billets/{uid}/{allPaths=**} {
      allow read:   if isOwner(uid) || isAdmin();
      allow write:  if isOwner(uid)
        && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── Ententes signées au doigt (page publique /signer-cuisine) ─
    // Le cuisinier n'a pas de compte : la création reste publique,
    // bornée à un PDF de moins de 10 Mo. Pas de lecture publique et
    // pas d'écrasement : une entente porte un nom et une signature
    // manuscrite, donc elle ne se lit que par l'équipe (Loi 25). Le
    // document Firestore ne garde que ce chemin, et l'admin résout
    // l'adresse de téléchargement en étant connecté.
    match /contrats-signes/{contrat}/{fileName} {
      allow read:   if isAdmin();
      allow create: if request.resource.contentType == 'application/pdf'
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ── Documents financiers (section admin Finances) ────────────
    // États financiers, factures, rapports. Contrairement à /media et
    // /archives-uploads, PAS de lecture publique : données financières,
    // admin seulement des deux côtés.
    match /finances/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // ── Portraits du carnet de contacts (section admin) ───────────
    // Personnes réelles (élus, partenaires…), pas de lecture publique.
    match /carnet-contacts/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // ── Le Souk : photos des objets mis en vente entre membres ────
    // Même geste que photos-publiques : redimensionnement navigateur
    // en webp avant l'envoi. Suppression réservée au propriétaire ou à
    // l'équipe. Lecture alignée sur la base le 2026-09-02 (Loi 25,
    // article 10) : la place de marché se tient entre membres connectés.
    match /souk/{uid}/{fileName} {
      allow read:   if signedIn();
      allow create: if (isOwner(uid) || isAdmin())
        && request.resource.contentType == 'image/webp'
        && request.resource.size < 15 * 1024 * 1024;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── Le Commerce : photos de la fiche (jusqu'à 6) ───────────────
    // Lecture alignée sur la base le 2026-09-02 (Loi 25, article 10) :
    // /commerces se lit par les membres connectés, ses photos aussi.
    match /commerces/{uid}/{fileName} {
      allow read:   if signedIn();
      allow create: if (isOwner(uid) || isAdmin())
        && request.resource.contentType == 'image/webp'
        && request.resource.size < 15 * 1024 * 1024;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Deny everything else by default.
  }
}

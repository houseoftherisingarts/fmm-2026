rules_version = '2';

// ─── FMM 2026 Firestore security rules ─────────────────────────────
// Strategy:
//   • Each authenticated user owns their /users/{uid}, /benevoles/{uid}
//     and /vendors/{uid} branch.
//   • Admins (email allowlist below) can read & write everything.
//   • The public can read only what's explicitly marked public
//     (accepted vendor list, site flags).
//   • Community wall (posts/dms) is restricted to authenticated users —
//     finer-grained rules can layer in once we move admin to custom
//     claims; for now the email allowlist gates all admin actions.
//
// Keep the email list below in sync with VITE_ADMIN_EMAILS in .env.local
// (full emails) and with any domain entries handled in the client. For
// rules, only full emails are easily expressible; domain entries are
// optional convenience for the *client UI only* and should not be
// trusted on the server side.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          // N'ÉCRIVEZ RIEN ICI À LA MAIN. La liste vit dans
          // config/equipe-admin.json et se recopie toute seule.
          // ÉQUIPE:DÉBUT (écrit par scripts/sync-equipe.mjs)
          'admin@festivalmedievaldemontpellier.org', // Boîte du festival
          'alex@lesalondesinconnus.com', // Alex
          'houseoftherisingarts@gmail.com', // Alex, second courriel
          'm.fournel11@gmail.com', // Maïté, Master Bénévole
          'benevoles.medievalmontpellier@gmail.com', // Maïté, courriel de fonction
          // ÉQUIPE:FIN
        ];
    }

    // Fields on a bénévole doc that only an admin (or the server) may ever set
    // or change. Everything else on the doc is the applicant's own form data.
    // Add any future sensitive field here so the owner can't forge it.
    function benevoleAdminOnlyFields() {
      return ['status', 'adminNotes', 'teamId', 'teamRole', 'badges',
              'hoursLogged', 'assignedShifts', 'pastYears'];
    }

    // ── Users (profiles) ─────────────────────────────────────────
    // Owner + admin only: the doc carries email/phone, so an open
    // signedIn() read would let any self-registered account harvest
    // every member's contact info (decision Alex 2026-07-04). The
    // community wall doesn't need it — posts embed authorName/hue.
    // Les droits payés ou gagnés (sans publicité, filleuls, billet offert)
    // s'écrivent depuis le serveur seulement : un membre ne se les
    // attribue pas lui-même.
    function userChampsServeur() {
      return ['sansPub', 'sansPubLe', 'sansPubPaymentId', 'sansPubRaison', 'filleuls', 'filleulsMajLe', 'billetOffert'];
    }
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && !request.resource.data.keys().hasAny(userChampsServeur());
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(userChampsServeur()));
      allow delete: if isAdmin();
    }

    // ── Bénévoles ────────────────────────────────────────────────
    // Owner can submit + edit their application. Admin can read + update
    // status + adminNotes. Bénévole-to-bénévole reads are blocked here
    // because the doc carries private fields (allergies, address, etc).
    // Public profile data is exposed via composePublicProfile in client.
    // Ce qu'un candidat a le droit de changer lui-même : tout son
    // formulaire, plus le statut, et seulement pour repartir en attente.
    function benevoleChampsCandidat() {
      return ['status', 'updatedAt', 'daysAvailable', 'stationPreferences',
              'heardFrom', 'heardFromOther', 'message', 'prenom', 'nom',
              'pronouns', 'pronounsOther', 'ageRange', 'minorGuardianPresent',
              'telephone', 'tShirtSize', 'tShirtSizeOther', 'allergies',
              'dietaryNotes', 'needsCamping', 'priorVolunteerFMM',
              'priorVolunteerOther', 'otherComments', 'consent', 'email',
              'year', 'source', 'createdAt'];
    }

    match /benevoles/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      // Create: the applicant opens their OWN pending application. They may not
      // self-approve or seed any admin-only field at creation time.
      allow create: if isOwner(uid)
                    && request.resource.data.status == 'pending'
                    && !request.resource.data.keys().hasAny(
                         ['adminNotes', 'teamId', 'teamRole', 'badges',
                          'hoursLogged', 'assignedShifts', 'pastYears']);
      // Update: an admin may change anything. The owner may edit their own form
      // data but must never touch status/adminNotes/team/hours/etc. We compare
      // by diff().affectedKeys() (keys whose VALUE actually changes) so the
      // full-doc round-trip the signature step sends — which re-includes
      // unchanged admin fields verbatim — still passes.
      // Le propriétaire retouche son formulaire. Il ne touche à aucun
      // champ d'administration, à une exception près : retravailler une
      // candidature refusée la remet EN ATTENTE, sinon elle restait
      // enterrée et personne ne la revoyait (Alex, 2026-08-23).
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(benevoleAdminOnlyFields()))
                    || (isOwner(uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(benevoleChampsCandidat())
                        && request.resource.data.status == 'pending'
                        && resource.data.status != 'accepted');
      allow delete: if isAdmin();

      // Admin-only private notes about the applicant, kept OFF the main doc so
      // the owner (who can read their own doc) can't read Maïté's notes.
      match /private/{doc} {
        allow read, write: if isAdmin();
      }

      // Bénévole ↔ FMM messaging thread
      match /messages/{msgId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) || isAdmin())
                      && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ── Vendors (one application per merchant per year) ──────────
    // /vendors/{uid}/years/{year} — owner writes their own; public reads
    // accepted vendors (used by the public marketplace listing).
    match /vendors/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      match /years/{year} {
        allow read: if isOwner(uid) || isAdmin()
                    || resource.data.status == 'accepted';   // public can list approved booths
        allow create: if isOwner(uid);
        allow update: if isOwner(uid) || isAdmin();
        allow delete: if isAdmin();
      }

      // Vendor ↔ FMM messaging thread
      match /messages/{msgId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) || isAdmin())
                      && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ── Teams ────────────────────────────────────────────────────
    // Read open to any signed-in user; only admins create/edit/delete.
    match /teams/{teamId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ── Community wall (posts + comments + reactions + subscribers) ─
    // Open to any signed-in user. Authors can edit/delete their own
    // posts; admins can moderate.
    match /posts/{postId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin()
                            || (signedIn() && resource.data.authorUid == request.auth.uid);

      match /comments/{commentId} {
        allow read:   if signedIn();
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isAdmin()
                              || (signedIn() && resource.data.authorUid == request.auth.uid);
      }
      match /reactions/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
      match /subscribers/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
    }

    // ── La tenue de la place ─────────────────────────────────────
    // Le festival accueille des mineurs, donc chacun garde une porte
    // de sortie : faire taire quelqu'un, et signaler un message à
    // l'équipe (Alex, 2026-08-23).
    //
    // Le blocage vaut vraiment dans les messages privés : la règle va
    // lire la liste du destinataire avant d'accepter l'envoi, et le
    // message ne part pas. Dans le salon public il ne peut être qu'un
    // silence du côté de celui qui bloque, puisque personne ne retire
    // la parole à un autre devant tout le monde.
    function estBloquePar(autre) {
      return exists(/databases/$(database)/documents/blocages/$(autre))
             && request.auth.uid in get(/databases/$(database)/documents/blocages/$(autre)).data.uids;
    }

    // La liste de quelqu'un ne regarde que lui. Les `get()` ci-dessus
    // passent outre les règles de lecture, donc la fermeture tient.
    match /blocages/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Un signalement se dépose en son propre nom et ne se relit pas :
    // seule l'équipe en prend connaissance.
    match /signalements/{docId} {
      allow create: if signedIn()
                    && request.resource.data.parUid == request.auth.uid
                    && request.resource.data.texte is string
                    && request.resource.data.texte.size() <= 2000
                    && request.resource.data.get('genre', 'billet') in ['billet', 'offre', 'demande']
                    // Le badge Admin · Modérateur ne se donne pas soi-même.
                    && (request.resource.data.get('moderateur', false) != true || isAdmin())
                    // La coche bleue sur un billet ne se recopie que si la fiche la porte.
                    && (request.resource.data.get('verifie', false) != true
                        || get(/databases/$(database)/documents/membres/$(request.auth.uid)).data.get('verifie', false) == true);
      allow read, update, delete: if isAdmin();
    }

    // ── Le salon de l'Ordre : la place publique ──────────────────
    // Tous les membres connectés lisent, chacun n'écrit qu'en son
    // propre nom, et personne ne retouche ni n'efface le mot d'un
    // autre. Retirer le sien reste possible, l'équipe peut retirer
    // n'importe lequel.
    match /salonOrdre/{motId} {
      allow read:   if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.texte is string
                    && request.resource.data.texte.size() > 0
                    && request.resource.data.texte.size() <= 2000
                    && request.resource.data.nom is string
                    && request.resource.data.nom.size() <= 120;
      allow update: if false;
      allow delete: if isAdmin()
                    || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ── Les messages privés ──────────────────────────────────────
    // Un fil ne se lit et ne s'écrit que par ses deux participants.
    // La clé du fil est la paire d'uid triée, jointe par '__'.
    match /dms/{threadId} {
      allow read:  if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.participantUids
                    && request.resource.data.participantUids.size() == 2
                    && !estBloquePar(
                         request.resource.data.participantUids.removeAll([request.auth.uid])[0]);
      // La liste des participants ne bouge plus : sans cela, l'un des
      // deux pourrait se substituer l'autre après coup.
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participantUids
                    && request.resource.data.participantUids == resource.data.participantUids;
      allow delete: if isAdmin();

      match /messages/{msgId} {
        function fil() {
          return get(/databases/$(database)/documents/dms/$(threadId)).data;
        }
        allow read: if signedIn()
                    && request.auth.uid in fil().participantUids;
        allow create: if signedIn()
                      && request.auth.uid == request.resource.data.senderUid
                      && request.auth.uid in fil().participantUids
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 2000
                      && !estBloquePar(fil().participantUids.removeAll([request.auth.uid])[0]);
        // Personne ne réécrit ni n'efface le message d'un autre, et
        // personne ne réécrit le sien après l'avoir envoyé.
        allow update, delete: if isAdmin();
      }
    }


    // ── Parties de tafl (Hnefatafl en joueur contre joueur) ──────
    // Le document sert de défi puis de partie. Seuls les deux joueurs
    // le lisent et l'écrivent; personne ne peut se glisser dans une
    // partie existante puisque la liste des joueurs ne bouge plus.
    match /taflParties/{partieId} {
      // Un défi ouvert par lien se lit par n'importe quel membre : c'est
      // le lobby que l'ami reçoit dans Messenger (Alex, 2026-08-23).
      // Le lobby d'un défi par lien se lit SANS compte : l'ami qui
      // reçoit le lien dans Messenger doit voir qui l'attend avant de
      // s'inscrire (Alex, 2026-08-23). Le document ne montre alors
      // qu'un nom d'affichage et un règlement.
      allow read:   if resource.data.statut == 'lobby'
                    || (signedIn() && request.auth.uid in resource.data.joueurs);
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.joueurs
                    && request.auth.uid == request.resource.data.lancePar
                    && request.resource.data.coups.size() == 0
                    && request.resource.data.gagnant == null
                    // La collection porte les trois jeux de plateau
                    // depuis le 31 août 2026, et chacun a son propre
                    // vocabulaire de camps ('attacker', '1', 'oies'…).
                    // La partie doit donc ouvrir sur un camp qu'elle
                    // déclare elle-même, plus sur un nom en dur.
                    && request.resource.data.tour in request.resource.data.camps.keys()
                    && (
                      // Un défi nommé s'ouvre à deux, en attente.
                      (request.resource.data.statut == 'defi'
                       && request.resource.data.joueurs.size() == 2)
                      // Un défi par lien s'ouvre seul, siège libre.
                      || (request.resource.data.statut == 'lobby'
                          && request.resource.data.joueurs.size() == 1)
                    );
      // Prendre le siège libre d'un défi ouvert : le seul cas où
      // quelqu'un qui n'est pas encore dans la partie peut l'écrire.
      allow update: if signedIn()
                    && resource.data.statut == 'lobby'
                    && !(request.auth.uid in resource.data.joueurs)
                    && request.resource.data.statut == 'encours'
                    && request.resource.data.joueurs.size() == 2
                    && request.auth.uid in request.resource.data.joueurs
                    && request.resource.data.lancePar == resource.data.lancePar
                    && request.resource.data.coups.size() == 0;
      allow update: if signedIn()
                    && request.auth.uid in resource.data.joueurs
                    && request.resource.data.joueurs == resource.data.joueurs
                    && request.resource.data.camps == resource.data.camps
                    && request.resource.data.lancePar == resource.data.lancePar
                    // Un refus est définitif : plus rien ne se rouvre
                    // par-dessus, et le défieur ne peut pas insister.
                    && resource.data.statut != 'refuse'
                    && resource.data.statut != 'fini';
      // Celui qui a ouvert une chambre publique et que personne n'est
      // venu rejoindre la referme lui-même (Alex, 2026-09-01) : une
      // table vide dans la liste des salons fait cliquer pour rien.
      allow delete: if isAdmin()
                    || (signedIn()
                        && resource.data.statut == 'lobby'
                        && request.auth.uid == resource.data.lancePar);

      // ── Le clavardage de la table ────────────────────────────────
      // Ce qui se dit pendant la partie appartient aux deux joueurs et
      // à personne d'autre. Un message ne se corrige pas et ne
      // s'efface pas : c'est ce qui permet de juger une plainte.
      match /messages/{messageId} {
        function laPartie() {
          return get(/databases/$(database)/documents/taflParties/$(partieId)).data;
        }
        allow read:   if signedIn() && request.auth.uid in laPartie().joueurs;
        allow create: if signedIn()
                      && request.auth.uid in laPartie().joueurs
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.texte is string
                      && request.resource.data.texte.size() > 0
                      && request.resource.data.texte.size() <= 240
                      && request.resource.data.nom is string
                      && request.resource.data.nom.size() <= 60;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ── L'Ordre : les fiches des membres ──────────────────────────
    // Chacun publie la sienne, tous les membres connectés les lisent.
    // Le champ `roles` fait exception : les fonctions portées au
    // festival (administrateur, trésorier, sécurité…) se décernent
    // depuis l'espace admin. Personne ne se les donne à soi-même
    // (Alex, 2026-08-23).
    match /membres/{uid} {
      // Loi 25, articles 13 et 9.1 (audit du 2026-09-02). Les outils
      // tools/importer-profils-fmm.mjs, tools/importer-profils-zeffy.mjs
      // et la fonction importerComptesZeffy versent au registre le vrai
      // nom de gens tirés des exports de billetterie. Ces personnes
      // n'ont posé aucun geste, et un `signedIn()` nu laissait n'importe
      // quelle adresse jetable lire un millier de noms en une minute.
      //
      // La fiche importée ne se lit donc que par elle-même et par
      // l'équipe, jusqu'à ce que la personne se connecte pour de vrai :
      // AuthContext.tsx pose alors `importe: false` et la fiche entre au
      // registre. Une fiche à qui le champ manque reste cachée, et c'est
      // voulu : l'outil zeffy n'écrit que l'étiquette « importé » sans le
      // drapeau, et le doute doit profiter à la personne. assurerFiche()
      // pose le drapeau à faux dès qu'une vraie inscription crée la fiche.
      //
      // listerMembres() porte le même filtre `importe == false`, sans
      // quoi Firestore refuserait la requête au complet.
      allow read:   if isAdmin() || isOwner(uid)
                    || (signedIn() && resource.data.importe == false);
      allow create: if isAdmin()
                    || (isOwner(uid)
                        && !('roles' in request.resource.data)
                        && !('tags'  in request.resource.data)
                        && !('verifie' in request.resource.data)
                        && !('vip' in request.resource.data)
                        // La signature du dernier changement de fonctions
                        // (definirRoles, ordre.ts) vaut ce que vaut son
                        // interdiction d'écriture : sans ces trois lignes,
                        // un membre nomme lui-même qui l'a promu.
                        && !('rolesPar' in request.resource.data)
                        && !('rolesParEmail' in request.resource.data)
                        && !('rolesLe' in request.resource.data)
                        // Le compteur de guildes fondées (CLAN-MONNAIE-CONTRAT.md,
                        // 6 sept 2026) : posé et incrémenté par le serveur seulement.
                        && !('guildesFondees' in request.resource.data));
      // `tags` suit exactement le sort de `roles` : les étiquettes de
      // groupe (viking, marchand du dimanche, municipalité) servent à
      // former les listes d'envoi de l'équipe, et personne ne se les
      // attribue tout seul (Alex, 2026-08-24).
      allow update: if isAdmin()
                    || (isOwner(uid)
                        // `verifie` (le badge bleu, Alex 2026-08-28) suit le même sort,
                        // et `vip` aussi : le serveur le pose quand users.sansPub passe à vrai.
                        // `guildesFondees` : le serveur seul l'incrémente à la
                        // fondation d'une guilde.
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['roles', 'tags', 'verifie', 'vip',
                                       'rolesPar', 'rolesParEmail', 'rolesLe',
                                       'guildesFondees'])
                        // `vuLe` (présence, sert à compter les actifs de guilde) :
                        // le propriétaire seul la pose, et seulement un timestamp.
                        && (!('vuLe' in request.resource.data.diff(resource.data).affectedKeys())
                            || request.resource.data.vuLe is timestamp));
      allow delete: if isAdmin();
    }

    // ── Le catalogue des étiquettes de groupe ─────────────────────
    // Un seul document, pour que l'équipe choisisse une étiquette dans
    // une liste au lieu de la retaper et de se retrouver avec trois
    // orthographes du même mot. Tout membre connecté le lit, puisque
    // ses propres étiquettes paraissent sur sa fiche; l'équipe seule
    // l'écrit.
    match /etiquettesOrdre/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ── L'historique des envois de groupe ─────────────────────────
    // Qui a écrit, quand, à qui, combien de fils, et le texte exact.
    // Alex doit pouvoir savoir ce qui est parti sans fouiller les fils
    // un par un. Réservé à l'équipe de bout en bout : un membre n'a
    // aucune raison de voir la liste des envois du festival. La Cloud
    // Function `messagerieDeMasse` écrit par le SDK d'administration,
    // qui passe outre ces règles, donc l'écriture reste fermée ici même
    // à l'équipe : personne ne fabrique une fausse trace à la main.
    match /envoisMasse/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Les campagnes de courriels ────────────────────────────────
    // La trace d'un envoi : qui a écrit, quand, quelle lettre, combien
    // sont partis et combien ont échoué. Réservée à l'équipe de bout en
    // bout. La Cloud Function `envoyerCampagne` écrit par le SDK
    // d'administration, qui passe outre ces règles, donc l'écriture
    // reste fermée ici même à l'équipe : personne ne fabrique une
    // fausse trace à la main, et le compte affiché dans l'admin est
    // toujours celui que la fonction a réellement constaté.
    match /campagnes/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Les ouvertures d'infolettre ───────────────────────────────
    // Une ligne par personne et par campagne, la clé porte les deux
    // sous la forme `<campagne>__<courriel>`. Elle dit quand cette
    // personne a ouvert la lettre la première fois, la dernière fois,
    // et combien de fois en tout.
    //
    // ÉCRITURE FERMÉE À TOUT LE MONDE, l'équipe comprise. La Cloud
    // Function `pixel` écrit par le SDK d'administration, qui passe
    // outre ces règles. Un taux d'ouverture qui se retouche depuis un
    // navigateur ne vaut plus rien, et le chiffre affiché dans l'admin
    // doit rester celui que la fonction a réellement constaté.
    //
    // La lecture reste à l'équipe : la collection porte l'adresse
    // courriel de gens réels et le moment où ils lisent leurs
    // messages. Rien de tout cela ne sort de l'admin.
    match /campagnesOuvertures/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Les campagnes programmées ─────────────────────────────────
    // Le rendez-vous d'un envoi : la lettre rendue, la portée des
    // destinataires, l'instant d'envoi et l'état. La fonction planifiée
    // `minuterieCampagnes` vient y chercher ce qui est dû, l'envoie et
    // écrit le résultat par le SDK d'administration, qui passe outre
    // ces règles.
    //
    // Réservée à l'équipe de bout en bout, comme le registre des
    // clients auquel la portée renvoie.
    //
    // L'ÉCRITURE EST ÉTROITE, et c'est voulu. L'équipe pose un
    // rendez-vous, et le seul geste qu'elle peut poser ensuite est
    // d'annuler une campagne encore prévue. Ni la lettre, ni l'heure,
    // ni la portée ne se retouchent après coup : une campagne qui doit
    // changer s'annule et se reprogramme, ce qui laisse les deux gestes
    // dans l'historique au lieu d'un document qui a changé de sens en
    // silence.
    //
    // Une campagne ne s'efface jamais. Une lettre partie à trois cents
    // personnes doit rester traçable, même quand elle s'est mal passée.
    match /campagnesProgrammees/{docId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
                    && request.resource.data.statut == 'prevue'
                    // Personne ne programme au nom de quelqu'un d'autre.
                    && request.resource.data.parCourriel == request.auth.token.email.lower()
                    && request.resource.data.envoiPrevuLe is timestamp
                    && request.resource.data.sujet is string
                    && request.resource.data.sujet.size() > 0
                    && request.resource.data.sujet.size() <= 200
                    // Les mêmes plafonds que la fonction d'envoi, pour
                    // qu'une lettre trop lourde soit refusée ici plutôt
                    // que de dormir trois semaines avant d'échouer.
                    && request.resource.data.html is string
                    && request.resource.data.html.size() > 0
                    && request.resource.data.html.size() < 200000
                    && request.resource.data.texte is string
                    && request.resource.data.texte.size() > 0
                    && request.resource.data.texte.size() < 200000
                    && request.resource.data.portee is map;

      // Annuler, et rien d'autre. Une campagne déjà en cours d'envoi ne
      // se rappelle pas : les courriels sont sortis.
      allow update: if isAdmin()
                    && resource.data.statut == 'prevue'
                    && request.resource.data.statut == 'annulee'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['statut', 'annuleeParNom', 'annuleeLe']);

      allow delete: if false;
    }

    // ── Les désabonnements ────────────────────────────────────────
    // La clé du document EST l'adresse en minuscules. Deux clics sur le
    // même lien écrivent donc le même document, et la liste ne peut pas
    // contenir deux fois la même personne.
    //
    // La création est ouverte SANS COMPTE, et c'est voulu : quelqu'un
    // qui reçoit une lettre doit pouvoir se retirer d'un seul geste,
    // sans avoir à s'inscrire sur le site pour cela. C'est la loi
    // canadienne anti-pourriel, et c'est aussi la simple politesse.
    //
    // Le chemin normal passe par la fonction `desabonnement`, qui
    // vérifie la signature du lien avant d'écrire. Cette voie-ci reste
    // ouverte pour qu'une page du site puisse faire le même geste un
    // jour, et la forme du document y est verrouillée : rien d'autre
    // que les trois champs attendus n'entre, et l'adresse doit
    // correspondre à la clé.
    //
    // ponytail: le plafond d'abus est qu'un inconnu désabonne une
    // adresse qu'il connaît déjà, ou gonfle la collection de fausses
    // adresses. Les règles Firestore ne savent pas limiter un débit. Si
    // cela devait arriver, la voie à fermer est celle-ci (`allow create:
    // if false`), et le lien signé de la fonction suffit à tout.
    match /desabonnements/{courriel} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['courriel', 'source', 'desabonneLe'])
                    && request.resource.data.courriel is string
                    && request.resource.data.courriel == courriel
                    && request.resource.data.courriel.size() > 4
                    && request.resource.data.courriel.size() < 200
                    && request.resource.data.courriel.matches('^[^@ ]+@[^@ ]+[.][a-zA-Z]+$')
                    && request.resource.data.source is string
                    && request.resource.data.source.size() < 40;
      // Remettre une adresse sur la liste est un geste de l'équipe,
      // jamais celui d'un inconnu : personne ne doit pouvoir réinscrire
      // quelqu'un qui s'est retiré.
      allow update, delete: if isAdmin();
    }

    // ── L'Ordre : les amitiés ─────────────────────────────────────
    // Une ligne par paire, la clé porte les deux uid triés. Les deux
    // membres de la paire écrivent, personne d'autre ne lit.
    match /amities/{lien} {
      allow read:   if signedIn() && request.auth.uid in resource.data.paire;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.paire
                    && request.resource.data.paire.size() == 2
                    && request.resource.data.de == request.auth.uid
                    && request.resource.data.statut == 'demande'
                    && lien == request.resource.data.paire[0] + '__' + request.resource.data.paire[1];
      // Seul le destinataire accepte : celui qui a demandé ne passe pas
      // le lien à 'amis' lui-même.
      allow update: if signedIn()
                    && request.auth.uid in resource.data.paire
                    && request.resource.data.paire == resource.data.paire
                    && request.resource.data.get('de', '') == resource.data.get('de', '')
                    && (request.resource.data.statut != 'amis'
                        || resource.data.statut == 'amis'
                        || request.auth.uid != resource.data.get('de', ''));
      allow delete: if signedIn() && request.auth.uid in resource.data.paire;
    }

    // ── Fiches d'activités (page Programmation) ──────────────────
    // Lecture publique : la page les affiche. Écriture : l'équipe.
    match /activitesFiches/{ficheId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── La table de tafl : qui accepte d'être défié ──────────────
    // Ne contient qu'un nom d'affichage, et chacun s'y met lui-même.
    match /taflJoueurs/{uid} {
      allow read:  if signedIn();
      allow write: if isOwner(uid);
    }

    // ── Les dés du menteur, à plusieurs mains ─────────────────────
    // Même patron que le tafl : le document porte le défi puis la
    // partie, et le lobby d'un défi par lien se lit sans compte
    // (Alex, 2026-08-23).
    //
    // La différence tient aux mains. Le document partagé ne dit que
    // COMBIEN de dés chacun tient, jamais lesquels : les faces vivent
    // dans /mains/{uid}, que les règles ci-dessous ferment au seul
    // propriétaire jusqu'au dévoilement.
    match /desParties/{partieId} {
      function partieDes() {
        return get(/databases/$(database)/documents/desParties/$(partieId)).data;
      }

      allow read:   if resource.data.statut == 'lobby'
                    || (signedIn() && request.auth.uid in resource.data.joueurs);
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.joueurs
                    && request.auth.uid == request.resource.data.lancePar
                    && request.resource.data.mise == null
                    && request.resource.data.manche == 1
                    && request.resource.data.gagnant == null
                    && request.resource.data.mainsPretes.size() == 0
                    && (
                      // Un défi nommé s'ouvre à deux, en attente.
                      (request.resource.data.statut == 'defi'
                       && request.resource.data.joueurs.size() == 2)
                      // Un défi par lien s'ouvre seul, siège libre.
                      || (request.resource.data.statut == 'lobby'
                          && request.resource.data.joueurs.size() == 1)
                    );
      // Prendre le siège libre d'un défi ouvert : le seul cas où
      // quelqu'un qui n'est pas encore dans la partie peut l'écrire.
      allow update: if signedIn()
                    && resource.data.statut == 'lobby'
                    && !(request.auth.uid in resource.data.joueurs)
                    && request.resource.data.statut == 'encours'
                    && request.resource.data.joueurs.size() == 2
                    && request.auth.uid in request.resource.data.joueurs
                    && request.resource.data.lancePar == resource.data.lancePar
                    && request.resource.data.manche == 1;
      allow update: if signedIn()
                    && request.auth.uid in resource.data.joueurs
                    && request.resource.data.joueurs == resource.data.joueurs
                    && request.resource.data.lancePar == resource.data.lancePar
                    // Un refus est définitif, et une partie finie ne
                    // se rouvre pas par-dessus.
                    && resource.data.statut != 'refuse'
                    && resource.data.statut != 'fini';
      // Même geste qu'au tafl : l'hôte referme la chambre que personne
      // n'est venu rejoindre (Alex, 2026-09-01).
      allow delete: if isAdmin()
                    || (signedIn()
                        && resource.data.statut == 'lobby'
                        && request.auth.uid == resource.data.lancePar);

      // Le clavardage de la table, mêmes droits qu'au tafl.
      match /messages/{messageId} {
        allow read:   if signedIn() && request.auth.uid in partieDes().joueurs;
        allow create: if signedIn()
                      && request.auth.uid in partieDes().joueurs
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.texte is string
                      && request.resource.data.texte.size() > 0
                      && request.resource.data.texte.size() <= 240
                      && request.resource.data.nom is string
                      && request.resource.data.nom.size() <= 60;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // La main scellée d'un joueur, pour la manche en cours.
      //
      // Les deux fonctions reçoivent la partie en argument pour que
      // chaque évaluation ne coûte qu'un seul get(). Firestore en
      // plafonne le nombre par requête, et le dévoilement lit la
      // sous-collection entière d'un coup.
      match /mains/{uid} {
        function auDevoilement(p) {
          return signedIn()
                 && request.auth.uid in p.joueurs
                 && p.phase == 'devoilement';
        }
        function pourLaMancheEnCours(p) {
          return request.auth.uid in p.joueurs
                 && request.resource.data.uid == uid
                 && request.resource.data.manche == p.manche;
        }
        // Chacun lit la sienne. Les autres n'y ont accès qu'une fois
        // les gobelets levés, et alors tout le monde en même temps.
        allow read:   if isOwner(uid) || auDevoilement(partieDes());
        // On scelle sa main pour la manche qui s'ouvre, jamais après.
        allow create: if isOwner(uid) && pourLaMancheEnCours(partieDes());
        // Une main ne se récrit qu'à la manche suivante. Pendant la
        // manche en cours elle est figée : impossible de changer ses
        // dés après avoir entendu les annonces.
        allow update: if isOwner(uid)
                      && request.resource.data.manche > resource.data.manche
                      && pourLaMancheEnCours(partieDes());
        allow delete: if isAdmin();
      }
    }

    // ── Le mur social (Alex, 2026-08-27) ─────────────────────────
    // Tout membre connecté lit le mur et y écrit en son nom. Chacun
    // retire ses propres billets; l'équipe retire n'importe lequel.
    // `guildeId` (optionnel) : un billet posté sur le mur d'une guilde
    // n'est accepté que si l'auteur en est membre.
    match /mur/{postId} {
      // Les billets d'une guilde se lisent entre membres de la guilde et
      // par l'équipe seulement (Alex, 2026-08-28). Le mur général
      // interroge `guildeId == null`, ce qui rend la règle prouvable.
      allow read:   if signedIn()
                    && (resource.data.guildeId == null
                        || isAdmin()
                        || request.auth.uid in get(/databases/$(database)/documents/guildes/$(resource.data.guildeId)).data.membres);
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.texte is string
                    && request.resource.data.texte.size() <= 2000
                    && (request.resource.data.guildeId == null
                        || request.auth.uid in get(/databases/$(database)/documents/guildes/$(request.resource.data.guildeId)).data.membres)
                    // Le ballon d'hélium (Alex, 2026-08-28) : le client pose
                    // les compteurs à zéro seulement, jamais un chiffre.
                    // La fonction serveur seule les fait bouger ensuite.
                    && request.resource.data.get('pour', 0) == 0
                    && request.resource.data.get('contre', 0) == 0
                    && request.resource.data.get('score', 0) == 0
                    && request.resource.data.get('nbCommentaires', 0) == 0
                    && request.resource.data.chaleur is number;
      // L'épinglage (Alex, 2026-08-28) : une exception étroite à « rien
      // ne se met à jour », qui n'ouvre QUE ces deux champs, et
      // seulement à qui a le droit d'épingler ce billet précis. Les
      // compteurs de votes restent la propriété exclusive de la
      // fonction serveur, qui contourne ces règles (Admin SDK).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['epingle', 'epingleLe'])
                    && (
                      // Le mur général : l'équipe du festival.
                      (resource.data.guildeId == null && isAdmin())
                      // Le mur d'une guilde : l'admin de cette guilde, ou l'équipe.
                      || (resource.data.guildeId != null
                          && (isAdmin()
                              || request.auth.uid in get(/databases/$(database)/documents/guildes/$(resource.data.guildeId)).data.admins))
                    );
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // Le vote sur un billet : chacun n'écrit que son propre vote, et
      // la fonction serveur murVoteBillet recalcule les compteurs sur
      // le billet à partir de tous les votes.
      match /votes/{voterUid} {
        allow read:   if signedIn();
        allow create, update: if signedIn()
                              && request.auth.uid == voterUid
                              && request.resource.data.valeur in [1, -1];
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == voterUid);
      }

      // Les commentaires, votés eux aussi comme sur Reddit.
      match /commentaires/{cid} {
        allow read:   if signedIn();
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.texte is string
                      && request.resource.data.texte.size() > 0
                      && request.resource.data.texte.size() <= 1000
                      && request.resource.data.get('pour', 0) == 0
                      && request.resource.data.get('contre', 0) == 0
                      && request.resource.data.get('score', 0) == 0
                      // La coche bleue sur un commentaire ne se recopie que
                      // si la fiche la porte (même patron que /signalements).
                      && (request.resource.data.get('verifie', false) != true
                          || get(/databases/$(database)/documents/membres/$(request.auth.uid)).data.get('verifie', false) == true);
        allow update: if false;
        allow delete: if isAdmin()
                      || (signedIn() && resource.data.uid == request.auth.uid)
                      || (signedIn() && get(/databases/$(database)/documents/mur/$(postId)).data.uid == request.auth.uid);

        match /votes/{voterUid} {
          allow read:   if signedIn();
          allow create, update: if signedIn()
                                && request.auth.uid == voterUid
                                && request.resource.data.valeur in [1, -1];
          allow delete: if isAdmin() || (signedIn() && request.auth.uid == voterUid);
        }
      }
    }

    // ── Les guildes : sous-groupes fondés par les membres ─────────
    // N'importe quel membre de l'Ordre fonde sa guilde et en devient
    // l'unique admin. Les autres demandent à joindre; l'admin de la
    // guilde (le fondateur) accepte ou refuse. L'équipe du festival
    // garde la main pour modifier ou détruire n'importe quelle guilde
    // depuis l'espace admin (Alex, 2026-08-27).
    match /guildes/{id} {
      // Champs de monnaie et d'invitation : posés/maintenus par le
      // serveur seulement (functions/guildes.js). Un client qui pourrait
      // les écrire s'inventerait un taux, un trésor ou un code à volonté
      // (contrat CLAN-MONNAIE-CONTRAT.md, 6 sept 2026).
      function guildeChampsServeur() {
        return ['taux', 'tresor', 'nbActifs', 'tauxHistorique', 'codeInvitation'];
      }

      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.creePar == request.auth.uid
                    && request.resource.data.admins == [request.auth.uid]
                    && request.resource.data.membres == [request.auth.uid]
                    && request.resource.data.demandes.size() == 0
                    && request.resource.data.nom is string
                    && request.resource.data.nom.size() >= 2
                    && request.resource.data.nom.size() <= 60
                    && request.resource.data.slug is string
                    && request.resource.data.slug.size() >= 3
                    && request.resource.data.slug.size() <= 80
                    && request.resource.data.slug.matches('^[a-z0-9-]+$')
                    && !request.resource.data.keys().hasAny(guildeChampsServeur())
                    // Une seule guilde fondée par membre (registre côté
                    // membres/{uid}.guildesFondees, posé par le serveur).
                    // Fiche absente = personne n'a encore rien fondé.
                    && (!exists(/databases/$(database)/documents/membres/$(request.auth.uid))
                        || get(/databases/$(database)/documents/membres/$(request.auth.uid)).data.get('guildesFondees', 0) == 0);

      // L'équipe fait tout. L'admin de la guilde édite la fiche
      // (monnaie, adresse, portrait des fondateurs, description…) mais
      // ne touche jamais l'argent, le code d'invitation ni la liste des
      // membres par ce chemin : guildeRejoindreParCode, guildeNouveauCode
      // et les callables de monnaie passent par l'Admin SDK, hors de ces
      // règles. N'importe quel membre connecté ne peut que se demander
      // lui-même (rejoindre / annuler sa demande) ou se retirer
      // lui-même (quitter) : jamais bouger la ligne d'un autre.
      allow update: if isAdmin()
                    || (request.auth.uid in resource.data.admins
                        && request.resource.data.creePar == resource.data.creePar
                        && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['monnaie', 'slug', 'membresFondateurs', 'nom',
                                        'description', 'forme', 'blason', 'banniereUrl', 'maj'])
                        && (!('slug' in request.resource.data.diff(resource.data).affectedKeys())
                            || (request.resource.data.slug is string
                                && request.resource.data.slug.size() >= 3
                                && request.resource.data.slug.size() <= 80
                                && request.resource.data.slug.matches('^[a-z0-9-]+$')))
                        && (!('monnaie' in request.resource.data.diff(resource.data).affectedKeys())
                            || (request.resource.data.monnaie.nom is string
                                && request.resource.data.monnaie.sigle is string
                                && request.resource.data.monnaie.sigle.size() >= 2
                                && request.resource.data.monnaie.sigle.size() <= 4
                                && request.resource.data.monnaie.glyphe is string))
                        && (!('membresFondateurs' in request.resource.data.diff(resource.data).affectedKeys())
                            || (request.resource.data.membresFondateurs is list
                                && request.resource.data.membresFondateurs.size() <= 50))
                        && (!('nom' in request.resource.data.diff(resource.data).affectedKeys())
                            || (request.resource.data.nom is string
                                && request.resource.data.nom.size() >= 2
                                && request.resource.data.nom.size() <= 60))
                        && (!('description' in request.resource.data.diff(resource.data).affectedKeys())
                            || (request.resource.data.description is string
                                && request.resource.data.description.size() <= 2000))
                        && (!('forme' in request.resource.data.diff(resource.data).affectedKeys())
                            || request.resource.data.forme in
                                 ['clan', 'guilde', 'compagnie', 'confrerie', 'troupe', 'maisonnee', 'ordre'])
                        && (!('blason' in request.resource.data.diff(resource.data).affectedKeys())
                            || (request.resource.data.blason is string
                                && request.resource.data.blason.size() <= 500))
                        && (!('banniereUrl' in request.resource.data.diff(resource.data).affectedKeys())
                            || (request.resource.data.banniereUrl is string
                                && request.resource.data.banniereUrl.size() <= 500)))
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['demandes', 'maj'])
                        && request.resource.data.demandes.removeAll(resource.data.demandes).hasOnly([request.auth.uid])
                        && resource.data.demandes.removeAll(request.resource.data.demandes).hasOnly([request.auth.uid]))
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membres', 'nbMembres', 'maj'])
                        && request.resource.data.membres.removeAll(resource.data.membres).size() == 0
                        && resource.data.membres.removeAll(request.resource.data.membres).hasOnly([request.auth.uid]));

      allow delete: if isAdmin() || request.auth.uid in resource.data.admins;
    }

    // ── Sous-collections de guilde : monnaie, agenda, salon ────────
    // Toutes SERVEUR SEULEMENT en écriture sauf le clavardage (les
    // membres y écrivent) et le RSVP d'événement (sa propre clé
    // seulement) — contrat CLAN-MONNAIE-CONTRAT.md, 6 sept 2026.
    function guildeMembre(guildeId) {
      return request.auth.uid in get(/databases/$(database)/documents/guildes/$(guildeId)).data.membres;
    }
    function guildeAdmin(guildeId) {
      return request.auth.uid in get(/databases/$(database)/documents/guildes/$(guildeId)).data.admins;
    }

    // La bourse en pièces de guilde : même patron que /bourses/{uid},
    // jamais écrite par un navigateur.
    match /guildes/{id}/bourses/{uid} {
      allow read:  if isOwner(uid) || isAdmin()
                   || (signedIn() && guildeAdmin(id));
      allow write: if false;
    }

    // Le registre des transactions de la guilde : lu par ses membres,
    // jamais écrit par un navigateur (les callables de functions/guildes.js
    // l'écrivent via l'Admin SDK).
    match /guildes/{id}/registre/{txId} {
      allow read:  if signedIn() && (isAdmin() || guildeMembre(id));
      allow write: if false;
    }

    // L'agenda de la guilde : les chefs le tiennent, les membres
    // répondent présent seulement sur leur propre clé.
    match /guildes/{id}/evenements/{evId} {
      function evenementChampsValides() {
        return request.resource.data.titre is string
               && request.resource.data.titre.size() >= 2
               && request.resource.data.titre.size() <= 120
               && request.resource.data.debut is timestamp
               && request.resource.data.fin is timestamp
               && request.resource.data.fin >= request.resource.data.debut
               && (!('prixPieces' in request.resource.data)
                   || (request.resource.data.prixPieces is int
                       && request.resource.data.prixPieces >= 0
                       && request.resource.data.prixPieces <= 100000));
      }

      allow read: if signedIn() && (isAdmin() || guildeMembre(id));

      allow create: if (isAdmin() || guildeAdmin(id))
                    && evenementChampsValides()
                    && !('nbOui' in request.resource.data);

      // Un chef modifie l'événement (jamais nbOui, recalculé par le
      // déclencheur serveur). Un membre ne touche que sa propre clé de
      // rsvp; s'il y a un prix en pièces, un « oui » client est refusé,
      // le paiement passe par guildeRsvpPayant (serveur).
      allow update: if ((isAdmin() || guildeAdmin(id))
                        && evenementChampsValides()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nbOui']))
                    || (signedIn() && guildeMembre(id)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp', 'maj'])
                        && request.resource.data.rsvp.diff(resource.data.rsvp).affectedKeys().hasOnly([request.auth.uid])
                        && request.resource.data.rsvp[request.auth.uid] in ['oui', 'non', 'peut-etre']
                        && (resource.data.get('prixPieces', 0) == 0
                            || request.resource.data.rsvp[request.auth.uid] != 'oui'));

      allow delete: if isAdmin() || guildeAdmin(id);
    }

    // Le salon de clavardage de la guilde : chaque membre écrit en son
    // nom, retire son propre mot; un chef ou l'équipe modère.
    match /guildes/{id}/clavardage/{msgId} {
      allow read:   if signedIn() && (isAdmin() || guildeMembre(id));
      allow create: if signedIn() && guildeMembre(id)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.texte is string
                    && request.resource.data.texte.size() >= 1
                    && request.resource.data.texte.size() <= 500
                    && request.resource.data.nom is string
                    && request.resource.data.creeLe == request.time;
      allow update: if false;
      allow delete: if isAdmin()
                    || (signedIn() && resource.data.uid == request.auth.uid)
                    || (signedIn() && guildeAdmin(id));
    }

    // ── La bourse en Montpellois (Alex, 2026-08-28) ──────────────
    // Le solde ne s'écrit QUE depuis les fonctions serveur, qui passent
    // par la clé d'administration : un navigateur qui pourrait écrire
    // ici s'offrirait un milliard de Montpellois.
    match /bourses/{uid} {
      // Une bourse rendue publique se lit par les autres membres.
      allow read:  if isOwner(uid) || isAdmin()
                   || (signedIn() && resource.data.get('publique', false) == true);
      allow write: if false;
    }

    // ── Votez avec votre portefeuille (Alex, 2026-09-06) ─────────
    // Les totaux se lisent par tout le monde : la page les montre même
    // à qui n'est pas connecté. Ils ne s'écrivent que depuis la
    // fonction `voterBudget`, qui débite la bourse dans le même geste.
    // Un navigateur qui pourrait écrire ici gonflerait son enveloppe
    // préférée sans payer une pièce.
    match /votesBudget/{docId} {
      allow read:  if true;
      allow write: if false;
    }
    // Ce qu'un membre a misé, enveloppe par enveloppe. Personne d'autre
    // ne le lit, sauf l'équipe.
    match /votesBudget/{docId}/membres/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ── Le parrainage (Alex, 2026-08-28) ─────────────────────────
    // La table d'unicité des codes : chacun réserve le sien, personne
    // ne réécrit celui d'un autre.
    match /codesParrain/{code} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Le lien de parrainage porte l'identifiant du filleul : une seule
    // fois dans sa vie, et jamais sur soi-même. Le compteur de filleuls
    // et les récompenses viennent de la fonction serveur, qui contourne
    // les règles; le navigateur n'y touche pas.
    match /parrainages/{filleulUid} {
      allow read:   if signedIn() && (request.auth.uid == filleulUid
                                      || request.auth.uid == resource.data.parrainUid
                                      || isAdmin());
      allow create: if signedIn()
                    && request.auth.uid == filleulUid
                    && request.resource.data.parrainUid is string
                    && request.resource.data.parrainUid != request.auth.uid
                    && request.resource.data.filleulUid == filleulUid;
      allow update, delete: if isAdmin();
    }

    // ── Les badges du site ────────────────────────────────────────
    // Chacun écrit les siens. La fiche d'un membre montre ses badges
    // aux autres membres connectés : le contenu n'est qu'une liste
    // d'identifiants, rien de personnel n'y transite (Alex,
    // 2026-08-23).
    // `exposes` : les badges mis en vitrine sur la fiche, cinq au plus
    // (Alex, 2026-08-27).
    // `obtenus` ne s'écrit que par le serveur (poserBadgeClient valide
    // l'identifiant) : chaque clé vaut des Montpellois. Le navigateur ne
    // touche qu'à sa vitrine et n'efface que ses annonces.
    match /badges/{uid} {
      function exposesValides() {
        return !('exposes' in request.resource.data)
               || (request.resource.data.exposes is list
                   && request.resource.data.exposes.size() <= 5);
      }
      allow read:   if signedIn();
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['exposes'])
                    && exposesValides();
      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exposes', 'aAnnoncer'])
                    && exposesValides()
                    && (!('aAnnoncer' in request.resource.data)
                        || request.resource.data.aAnnoncer.keys().hasOnly(resource.data.get('aAnnoncer', {}).keys()));
      allow delete: if false;
    }

    // ── Photos publiques (envoyées par les membres) ────────────────
    // Chacun téléverse ses propres photos (PhotosPanel de l'espace
    // compte) : elles partent en 'attente'. Une photo 'retenue' devient
    // publique (elle peut nourrir une affiche ou une page); les autres
    // statuts restent visibles seulement du propriétaire et de l'équipe.
    // Seule l'équipe change le statut, l'auteur ne peut pas s'auto-
    // approuver. Suppression réservée à l'équipe (section Photos reçues).
    // `visibilite` (Alex, 2026-08-27) : 'publique' paraît sur la fiche
    // du membre pour les autres membres connectés; 'privee' (ou absent,
    // les envois d'avant) reste entre la personne et l'équipe. L'auteur
    // peut la changer après coup, avec la légende.
    match /photosPubliques/{docId} {
      allow read:   if resource.data.statut == 'retenue'
                    || isAdmin()
                    || (signedIn() && resource.data.uid == request.auth.uid)
                    || (signedIn() && resource.data.visibilite == 'publique');
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.statut == 'attente'
                    && request.resource.data.consentement == true
                    && request.resource.data.visibilite in ['publique', 'privee'];
      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['legende', 'visibilite', 'vedette', 'ordre', 'personnes', 'personnesUids'])
                        && request.resource.data.visibilite in ['publique', 'privee']
                        // Une photo en vedette sur le profil est forcément publique.
                        && (request.resource.data.get('vedette', false) != true
                            || request.resource.data.visibilite == 'publique'))
                    // Une personne identifiée retire son propre repère (Alex,
                    // 2026-08-28) : son uid disparaît, la liste raccourcit
                    // d'exactement un, et rien d'autre n'est ajouté.
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personnes', 'personnesUids'])
                        && resource.data.get('personnesUids', []).hasAll([request.auth.uid])
                        && !request.resource.data.get('personnesUids', []).hasAny([request.auth.uid])
                        && request.resource.data.get('personnesUids', []).hasOnly(resource.data.get('personnesUids', []))
                        && request.resource.data.personnesUids.size() == resource.data.get('personnesUids', []).size() - 1
                        && request.resource.data.get('personnes', []).hasOnly(resource.data.get('personnes', []))
                        && request.resource.data.personnes.size() == resource.data.get('personnes', []).size() - 1);
      allow delete: if isAdmin();
    }

    // ── Les avis décrochés du babillard ───────────────────────────
    // La clé porte l'uid : personne ne peut décrocher un avis au nom
    // d'un autre. L'équipe voit qui a pris quoi.
    match /avisAcceptes/{docId} {
      allow read:   if isAdmin()
                    || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && docId == request.auth.uid + '__' + request.resource.data.avisId;
      allow delete: if isAdmin();
    }

    // ── Site flags (vendor open/closed, hero banner toggles) ──────
    match /siteFlags/{doc} {
      allow read:  if true;       // public read — gates public form visibility
      allow write: if isAdmin();
    }

    // ── Places du banquet · le compteur public ────────────────────
    // Un seul document, `banquetPlaces/compteur`, et il ne porte que
    // deux champs : `vendues` (un nombre) et `majLe` (une date). Aucun
    // acheteur, aucun courriel, aucun montant ne descend jamais ici,
    // parce que la page publique le lit pour afficher combien de places
    // restent sur les cinquante.
    //
    // L'écriture vient du webhook Square, qui parle par le SDK admin et
    // passe donc outre ces règles. Personne d'autre ne peut gonfler ni
    // vider le compteur; un admin garde la main pour corriger à la
    // main si un paiement d'essai s'est glissé dans le compte.
    // ── Concours William J. Walter (maquette /william) ───────────
    // Inscription publique, création seulement : le document porte le
    // courriel en identifiant, donc une seconde inscription échoue au
    // lieu d'écraser la première. Le consentement au partage avec le
    // commanditaire doit être vrai pour que l'écriture passe. Lecture
    // réservée à l'équipe, qui remet la liste au commanditaire.
    match /concoursWJW/{courriel} {
      // La personne lit sa propre participation (son espace l'affiche);
      // l'équipe lit tout et pose `gagnant` le jour du tirage.
      allow read: if isAdmin()
                  || (signedIn() && request.auth.token.email != null
                      && request.auth.token.email.lower() == courriel);
      allow create: if request.resource.data.keys().hasOnly(['nom', 'courriel', 'telephone', 'consentementPartage', 'inscritLe'])
                    && request.resource.data.courriel is string
                    && request.resource.data.courriel == courriel
                    && request.resource.data.courriel.size() > 4
                    && request.resource.data.courriel.size() < 200
                    && request.resource.data.nom is string
                    && request.resource.data.nom.size() > 1
                    && request.resource.data.nom.size() < 120
                    && request.resource.data.telephone is string
                    && request.resource.data.telephone.size() > 6
                    && request.resource.data.telephone.size() < 40
                    && request.resource.data.consentementPartage == true;
      allow update, delete: if isAdmin();
    }

    match /banquetPlaces/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Musicians (one application per musician per year) ────────
    // /musicians/{uid}/years/{year} — mirrors the vendors layout so
    // a band can have multi-year history. Accepted musicians are
    // publicly listed via composePublicMusician on the client.
    match /musicians/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      match /years/{year} {
        allow read:   if isOwner(uid) || isAdmin()
                      || resource.data.status == 'accepted';
        allow create: if isOwner(uid);
        allow update: if isOwner(uid) || isAdmin();
        allow delete: if isAdmin();
      }

      // Musician ↔ FMM messaging thread
      match /messages/{msgId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) || isAdmin())
                      && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ── Admin roles ──────────────────────────────────────────────
    // Pre-provisioned by super-admin, keyed by lowercased email.
    // A signed-in user can read their own role row (so the client UI
    // knows what to enable); only admins can write.
    match /adminRoles/{email} {
      allow read:  if isAdmin()
                   || (signedIn() && request.auth.token.email != null
                       && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }

    // ── Admin-only operational collections ───────────────────────
    // bar inventory, volunteer schedule, social-media planner, mail
    // tab (internal — different from inquiry-form `contacts`).
    match /bar/{docId}         { allow read, write: if isAdmin(); }
    // Horaire du festival : public en lecture (la page Programmation
    // s'y abonne), écriture réservée aux admins (section Horaire).
    match /schedule/{docId}    { allow read: if true; allow write: if isAdmin(); }
    // Compteurs de visites first-party (section admin Analytiques).
    // Écriture publique nécessaire (visiteurs anonymes), mais bornée
    // aux trois champs du compteur; lecture réservée aux admins.
    match /siteStats/{day} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['total', 'pages', 'sources', 'pubJeux', 'pubJeuxParJeu', 'updatedAt']);
      allow delete: if isAdmin();
    }
    // Finances (section admin Finances) : budget, comptes, répartition,
    // métadonnées des documents téléversés. Données sensibles, jamais
    // publiques.
    match /financeCategories/{docId}  { allow read, write: if isAdmin(); }
    match /financeAccounts/{docId}    { allow read, write: if isAdmin(); }
    match /financeAllocation/{docId}  { allow read, write: if isAdmin(); }
    match /financeDocuments/{docId}   { allow read, write: if isAdmin(); }
    match /financeReceivables/{docId} { allow read, write: if isAdmin(); }
    // Carnet de contacts (section admin Carnet de contacts) : organisateurs,
    // élus, partenaires, fournisseurs — avec rôle et allégeance. Donnée
    // sensible sur des personnes réelles, jamais publique. Collection
    // distincte de `contacts` (formulaire public "Nous contacter" ci-dessus).
    match /carnetContacts/{docId}     { allow read, write: if isAdmin(); }

    // Registre des clients (section admin Clients) : tout ce que le
    // festival a vendu depuis 2023, versé par tools/importer-clients.mjs
    // depuis les exports Zeffy. Noms, courriels et téléphones de vraies
    // personnes qui n'ont jamais consenti à être vues d'ailleurs que par
    // l'équipe. L'équipe seulement, en lecture comme en écriture, sans
    // condition, sans exception, et aucun chemin public nulle part.
    match /clients/{docId}     { allow read, write: if isAdmin(); }

    match /socialPosts/{docId} { allow read, write: if isAdmin(); }
    // Rapports publicitaires (section admin Publicité) : analyses de
    // campagne Meta, Google Ads, AdSense, journal, déposées par Claude.
    // L'équipe seulement, en lecture comme en écriture.
    match /rapports_pubs/{docId} { allow read, write: if isAdmin(); }
    // Team availability polls (Disponibilités : Doodle interne).
    match /teamPolls/{docId}   { allow read, write: if isAdmin(); }
    // Invités : liste des entrées gratuites tenue pour la porte.
    match /guestList/{docId}   { allow read, write: if isAdmin(); }
    // Groupes musicaux (programmation, section admin Musique, Éric
    // Pichette). Nommée `groupesMusicaux` et non `groupes` : cette
    // dernière est déjà prise par les demandes de visite de groupes
    // (GroupesPage.tsx, voir plus bas). Lecture publique : la page
    // publique Musique lit cette collection.
    match /groupesMusicaux/{docId} { allow read: if true; allow write: if isAdmin(); }

    // ── Public-create, admin-managed inquiry collections ─────────
    // Inquiry / newsletter / contact / behourd forms. Allow create
    // for any visitor; admins read & manage.
    match /mariages/{docId}    { allow create: if true; allow read, update, delete: if isAdmin(); }
    // Collection name matches the ChevauxPage form write (was `chevaux`,
    // which nothing writes: every clinique-équestre submission was denied).
    match /cliniqueEquestre/{docId} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /groupes/{docId}     { allow create: if true; allow read, update, delete: if isAdmin(); }
    // Collection name matches the JeunessePage form write (was `jeunesse`).
    match /jeunesseAteliers/{docId} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /contacts/{docId}    { allow create: if true; allow read, update, delete: if isAdmin(); }
    // Demandes de commandite (formulaire public /commanditaires, plans
    // Baron / Comte / Duc). Création publique verrouillée sur la forme
    // exacte du formulaire pour bloquer les docs-spam arbitraires.
    match /commanditaires/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['plan', 'company', 'contactName', 'email', 'phone', 'message', 'lang', 'year', 'status', 'createdAt'])
        && request.resource.data.plan in ['baron', 'comte', 'duc']
        && request.resource.data.company is string && request.resource.data.company.size() > 0 && request.resource.data.company.size() < 200
        && request.resource.data.contactName is string && request.resource.data.contactName.size() < 200
        && request.resource.data.email is string && request.resource.data.email.matches('.+@.+\\..+') && request.resource.data.email.size() < 200
        && request.resource.data.phone is string && request.resource.data.phone.size() < 60
        && request.resource.data.message is string && request.resource.data.message.size() < 4000
        && request.resource.data.lang in ['FR', 'EN']
        && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // ── Hébergeurs partenaires (formulaire public /hebergement) ──────
    // Un hébergeur (auberge, gîte, camping) laisse ses coordonnées, le
    // lien de son établissement et ses photos AVANT d'aller au paiement
    // Zeffy. L'hébergeur n'a pas de compte : la création est donc
    // publique, mais verrouillée sur la forme exacte du formulaire pour
    // bloquer les docs-spam arbitraires. Les URLs des photos sont écrites
    // dans le même create (elles sont téléversées d'abord, sous un id
    // généré côté client), donc aucune mise à jour publique n'est
    // nécessaire. Lecture et gestion réservées à l'équipe.
    //
    // ponytail: le plafond d'abus est un inconnu qui gonfle la collection
    // de fausses fiches; les règles Firestore ne bornent pas un débit. Si
    // cela devait arriver, fermer cette voie (`allow create: if false`) et
    // passer par une fonction signée. Le contenu de `photos` n'est pas
    // validé élément par élément (les règles n'itèrent pas une liste) :
    // borné en taille, lu par l'équipe seulement.
    match /hebergementsPartenaires/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['nom', 'courriel', 'telephone', 'lien', 'photos', 'statut', 'creeLe'])
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 1
        && request.resource.data.nom.size() < 200
        && request.resource.data.courriel is string
        && request.resource.data.courriel.matches('^[^@ ]+@[^@ ]+[.][a-zA-Z]+$')
        && request.resource.data.courriel.size() < 200
        && request.resource.data.telephone is string
        && request.resource.data.telephone.size() > 6
        && request.resource.data.telephone.size() < 40
        && request.resource.data.lien is string
        && request.resource.data.lien.matches('https?://.+')
        && request.resource.data.lien.size() < 500
        && request.resource.data.photos is list
        && request.resource.data.photos.size() > 0
        && request.resource.data.photos.size() <= 6
        && request.resource.data.statut == 'attente'
        && request.resource.data.creeLe is timestamp;
      allow read, update, delete: if isAdmin();
    }

    // ── Ententes signées au doigt (page publique /signer-cuisine) ─
    // Le cuisinier signe sans compte : la création est donc publique,
    // et verrouillée sur une forme exacte. Le document ne porte que le
    // chemin du PDF dans Storage, jamais une adresse publique : il se
    // lit par l'équipe seulement, et l'admin résout l'adresse de
    // téléchargement en étant connecté (contratsSignes.ts).
    match /contratsSignes/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['contrat', 'nom', 'chemin', 'signeLe'])
        && request.resource.data.contrat is string
        && request.resource.data.contrat.matches('^[a-z0-9-]{3,60}$')
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 1
        && request.resource.data.nom.size() < 200
        && request.resource.data.chemin is string
        && request.resource.data.chemin.matches('^contrats-signes/[a-z0-9-]{3,60}/[A-Za-z0-9]{1,64}[.]pdf$')
        && request.resource.data.signeLe is timestamp;
      allow read, update, delete: if isAdmin();
    }

    // ── Admin CRM internals ──────────────────────────────────────
    // RACI matrix (MatriceRolesSection + PersonProfilePage, admin only).
    match /matriceRoles/{docId} { allow read, write: if isAdmin(); }
    match /matriceTasks/{docId} { allow read, write: if isAdmin(); }
    // Archives photos de la page Histoire : la page publique lit tout,
    // seuls les admins (section Photos — Léna) écrivent.
    match /archivesPhotos/{docId} { allow read: if true; allow write: if isAdmin(); }
    // Vendor image overrides: admin writes, the public MarchePage reads.
    match /crm/vendor-image-overrides { allow read: if true; allow write: if isAdmin(); }
    // Broadcast templates (BroadcastComposer, admin only).
    match /crm/vendor-broadcasts { allow read, write: if isAdmin(); }
    match /newsletter/{docId}  {
      // Public create, but only the exact shape the two signup forms write —
      // blocks arbitrary-size spam docs on the open lane.
      allow create: if request.resource.data.keys().hasOnly(['email', 'lang', 'source', 'subscribedAt', 'unsubscribed'])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.lang in ['FR', 'EN']
        && request.resource.data.source is string
        && request.resource.data.source.size() < 40;
      allow read, update, delete: if isAdmin();
    }
    match /behourd/{docId}     { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /mail/{docId}        { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /bugReports/{docId}  { allow create: if true; allow read, update, delete: if isAdmin(); }

    // ── Outgoing email queue (Firebase Extension "Trigger Email") ─
    // Each doc dropped here is picked up by the extension and sent via
    // the configured SMTP. Admins queue any mail. Reads/edits/deletes
    // stay admin-only.
    //
    // Narrow public lane: the public "Signaler un bug" form may queue
    // ONE bug-report email, hard-locked to the two festival inboxes and
    // a "[Bug FMM]" subject. It cannot be used to send mail to anyone
    // else, so the abuse ceiling is bug spam to our own inboxes, the
    // same ceiling the form already has.
    function isBugReportMail() {
      return request.resource.data.to == [
               'admin@festivalmedievaldemontpellier.org',
               'alex@lesalondesinconnus.com'
             ]
        // Lock the doc shape: no cc/bcc/from smuggling, no extra fields —
        // otherwise this public lane becomes an open relay on our SMTP.
        && request.resource.data.keys().hasOnly(['to', 'message', 'queuedAt', 'replyTo'])
        && request.resource.data.message.keys().hasOnly(['subject', 'text', 'html'])
        && (!('replyTo' in request.resource.data)
            || (request.resource.data.replyTo is string
                && request.resource.data.replyTo.size() < 200))
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.matches('\\[Bug FMM\\].*');
    }
    match /mail-out/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || isBugReportMail();
    }

    // ── Le Souk : petite place de marché entre membres ────────────
    // Chacun revend ses objets usagés (costume, arme, artisanat, livre,
    // décor, autre). Lecture ouverte aux membres connectés (les
    // intéressés écrivent au vendeur par la messagerie); la fiche reste
    // la propriété de son auteur, l'équipe peut intervenir en secours.
    match /souk/{docId} {
      // Le prix en Montpellois est un entier de 0 à 100 000 : un prix
      // négatif renverserait le transfert dans acheterAuSouk.
      function prixMontpelloisValide() {
        return request.resource.data.get('prixMontpellois', 0) is int
               && request.resource.data.get('prixMontpellois', 0) >= 0
               && request.resource.data.get('prixMontpellois', 0) <= 100000;
      }
      // Le prix en pièces de guilde suit le même patron que le prix en
      // Montpellois (contrat CLAN-MONNAIE-CONTRAT.md, 6 sept 2026).
      function prixPiecesValide() {
        return !('prixPieces' in request.resource.data)
               || (request.resource.data.prixPieces is int
                   && request.resource.data.prixPieces >= 0
                   && request.resource.data.prixPieces <= 100000);
      }
      // Une annonce marquée guildeId n'est postée que par un membre de
      // cette guilde (get() sur la fiche de guilde).
      function guildeIdValide() {
        return !('guildeId' in request.resource.data)
               || (request.resource.data.guildeId is string
                   && request.auth.uid in
                        get(/databases/$(database)/documents/guildes/$(request.resource.data.guildeId)).data.membres);
      }
      allow read:   if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.titre is string
                    && request.resource.data.titre.size() >= 2
                    && request.resource.data.titre.size() <= 80
                    // Le prix en dollars est facultatif (Alex, 2026-08-28) :
                    // sans prix ni Montpellois, l'objet est donné.
                    && request.resource.data.get('prix', 0) is number
                    && request.resource.data.get('prix', 0) >= 0
                    && prixMontpelloisValide()
                    && prixPiecesValide()
                    && guildeIdValide();
      allow update: if isAdmin()
                    || (signedIn() && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == resource.data.uid
                        && prixMontpelloisValide()
                        && prixPiecesValide()
                        && guildeIdValide());
      allow delete: if isAdmin()
                    || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ── Le Commerce : une fiche par membre (docId == uid) ──────────
    // L'équivalent d'une page Facebook, non officielle tant qu'elle
    // n'est pas promue en kiosque (voir /vendors). Le propriétaire
    // écrit sa propre fiche; l'équipe peut la corriger ou la retirer.
    match /commerces/{uid} {
      allow read:           if signedIn();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete:         if isOwner(uid) || isAdmin();
    }

    // ── Chantier : inventaire du personnage + salon 2D ─────────────
    // Page non publiée (/chantier, gatée isAdmin côté client), mais les
    // règles restent réelles dès maintenant. Un document par membre,
    // lecture aux comptes connectés, écriture réservée au propriétaire
    // (Alex, 2026-08-27).
    match /avatars/{uid} {
      allow read:                  if signedIn();
      allow create, update, delete: if isOwner(uid) || isAdmin();
    }
    // Présence dans le salon : la personne écrit sa propre position et
    // son message, tout le monde connecté les lit. Expiration après deux
    // minutes gérée côté client sur le champ `maj` (Alex, 2026-08-27).
    match /salon2d/{uid} {
      allow read:                  if signedIn();
      allow create, update, delete: if isOwner(uid) || isAdmin();
    }
  }
}
